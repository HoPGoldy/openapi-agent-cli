{
  "openapi": "3.1.0",
  "info": {
    "title": "Xquik API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://xquik.com"
    }
  ],
  "paths": {
    "/api/v1/account": {
      "get": {
        "operationId": "getAccount",
        "summary": "Get account details",
        "responses": {
          "200": {
            "description": "Account details and current usage limits."
          }
        }
      }
    },
    "/api/v1/x/tweets/search": {
      "get": {
        "operationId": "searchTweets",
        "summary": "Search X posts",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching X posts."
          }
        }
      }
    },
    "/api/v1/x/tweets": {
      "post": {
        "operationId": "createTweet",
        "summary": "Create an X post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["text"],
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "Post text."
                  },
                  "replyToTweetId": {
                    "type": "string",
                    "description": "Optional parent post ID."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created post result."
          }
        }
      }
    },
    "/api/v1/webhooks": {
      "post": {
        "operationId": "createWebhook",
        "summary": "Create a webhook",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["url", "events"],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Webhook delivery URL."
                  },
                  "events": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Event names to subscribe to."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Webhook registration result."
          }
        }
      }
    }
  }
}
